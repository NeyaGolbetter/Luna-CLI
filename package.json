{
  "name": "luna-cli",
  "version": "0.1.0",
  "description": "Luna CLI - a modular, Termux-optimized terminal AI assistant with BYOAK, MCP tool execution, and a Roblox executor bridge over Cloudflare Tunnels.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "luna": "bin/luna"
  },
  "main": "dist/cli/index.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "node dist/cli/index.js",
    "chat": "node dist/cli/index.js chat",
    "test": "npm run build && node --test test/*.test.js"
  },
  "keywords": [
    "ai",
    "cli",
    "termux",
    "mcp",
    "model-context-protocol",
    "roblox",
    "executor",
    "cloudflare-tunnel",
    "llm"
  ],
  "dependencies": {
    "@inquirer/prompts": "^7.10.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "chalk": "^5.6.2",
    "commander": "^13.1.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "ora": "^8.2.0",
    "ws": "^8.21.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/ws": "^8.18.0",
    "typescript": "^5.8.0"
  }
}
